# ECR Image
ECR_IMAGE=123456789012.dkr.ecr.ap-northeast-2.amazonaws.com/playtab/user-service:latest

# Database (RDS)
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/playtab_identity
DB_USERNAME=
DB_PASSWORD=

# Redis
SPRING_DATA_REDIS_HOST=host.docker.internal

# Mail
MAIL_HOST=smtp.worksmobile.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# JWT
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
